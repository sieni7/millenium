{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Millenium Coop Initiative — Config Schema",
  "description": "Schéma de référence de public/config.json (état actuel du projet). Source de vérité : public/config.json.",
  "type": "object",
  "required": ["company", "hero", "services", "projects", "team", "testimonials", "partners"],
  "properties": {
    "company": {
      "type": "object",
      "required": ["name", "slogan", "mission", "phone", "whatsapp", "email", "address"],
      "properties": {
        "name": { "type": "string" },
        "slogan": { "type": "string" },
        "mission": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "logo_header": { "type": "string" },
        "logo_footer": { "type": "string" },
        "footer_credit": { "type": "string" },
        "footer_agreements": {
          "type": "array",
          "items": { "type": "object" }
        },
        "social": {
          "type": "object",
          "properties": {
            "whatsapp": { "type": "string" },
            "linkedin": { "type": "string" },
            "facebook": { "type": "string" },
            "instagram": { "type": "string" }
          }
        },
        "bottomNav": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label", "icon", "href"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "icon": { "type": "string" },
                  "href": { "type": "string" },
                  "visible": { "type": "boolean" },
                  "order": { "type": "integer" }
                }
              }
            }
          }
        },
        "widgets": {
          "type": "object",
          "properties": {
            "whatsapp": {
              "type": "object",
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "url": { "type": "string" },
                "position": { "type": "string", "enum": ["bottom-right", "bottom-left"] },
                "bottom": { "type": "integer" },
                "right": { "type": "integer" },
                "left": { "type": "integer" }
              }
            },
            "backToTop": {
              "type": "object",
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" },
                "threshold": { "type": "integer" }
              }
            },
            "progressBar": {
              "type": "object",
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "hero": {
      "type": "object",
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "subtitle", "cta"],
            "properties": {
              "title": { "type": "string" },
              "subtitle": { "type": "string" },
              "cta": { "type": "string" },
              "image": { "type": "string" }
            }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "icon"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "subtitle", "context", "challenge", "solution", "results"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "context": { "type": "string" },
          "challenge": { "type": "string" },
          "solution": { "type": "string" },
          "results": { "type": "string" },
          "image": { "type": "string" }
        }
      }
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "description"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "description": { "type": "string" },
          "photo": { "type": "string" }
        }
      }
    },
    "testimonials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "organization": { "type": "string" },
          "quote": { "type": "string" }
        }
      }
    },
    "partners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "logo": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string" },
          "group": { "type": "string" }
        }
      }
    },
    "i18n": {
      "type": "object",
      "properties": {
        "defaultLanguage": { "type": "string" },
        "fr": { "$ref": "#/definitions/language" },
        "en": { "$ref": "#/definitions/language" }
      }
    }
  },
  "definitions": {
    "language": {
      "type": "object",
      "properties": {
        "menu": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}